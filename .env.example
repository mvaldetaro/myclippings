# My Clippings - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme necessário.
#
# ── Uso ─────────────────────────────────────────────────────────────────────
#
# Desenvolvimento local:
#   1. cp .env.example .env
#   2. Gere um JWT_SECRET: openssl rand -hex 64
#   3. Substitua JWT_SECRET no .env
#
# Docker (docker compose):
#   1. cp .env.example .env
#   2. Gere um JWT_SECRET: openssl rand -hex 64
#   3. Substitua JWT_SECRET no .env
#   4. As variáveis são injetadas via `environment:` ou `${VAR}` no compose
#   5. docker compose up -d
#
# ── Banco de Dados ──────────────────────────────────────────────────────────
# Caminho para o arquivo SQLite.
# Docker: use caminho absoluto dentro do container (/app/data/database/...)
DATABASE_URL=./data/database/my-clippings.db

# ── Autenticação JWT ────────────────────────────────────────────────────────
# Segredo para assinatura dos tokens JWT.
# OBRIGATÓRIO em produção. Gere com: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-secret

# Tempo de expiração do token (formato: 15m, 1h, 7d)
JWT_EXPIRATION=24h

# ── Servidor API ────────────────────────────────────────────────────────────
# Porta do servidor HTTP (dentro do container sempre 3000).
# Docker: API_PORT é a porta exposta no host. Ex: API_PORT=3001 → host:3001 → container:3000
API_PORT=3001

# Host do servidor (0.0.0.0 para aceitar conexões externas)
API_HOST=0.0.0.0

# ── Diretórios de Dados ─────────────────────────────────────────────────────
# Diretório raiz para armazenamento de dados.
# Docker: use caminhos absolutos dentro do container (/app/data)
DATA_DIR=./data

# Diretório para arquivos Markdown dos usuários
USER_FILES_DIR=./data/users

# ── Upload ──────────────────────────────────────────────────────────────────
# Tamanho máximo do arquivo de upload (em bytes, default: 50MB)
MAX_UPLOAD_SIZE=52428800

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Número máximo de requisições por janela para rotas de auth/import
RATE_LIMIT_MAX=100

# Janela de rate limiting (em milissegundos, default: 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ─────────────────────────────────────────────────────────────────
# Nível de log (debug, info, warn, error)
LOG_LEVEL=info

# ── Ambiente ────────────────────────────────────────────────────────────────
# Ambiente de execução (development, production, test)
NODE_ENV=development

# ── Web App ─────────────────────────────────────────────────────────────────
# URL base do frontend (para CORS).
# Desenvolvimento: http://localhost:5173 (Vite dev server)
# Docker: http://localhost:3000 (nginx na porta exposta)
WEB_APP_URL=http://localhost:5173

# Porta do servidor frontend.
# Desenvolvimento: 5173 (Vite)
# Docker: 3000 (nginx exposto no host)
WEB_PORT=3000
