{
  "name": "my-clippings",
  "version": "0.1.0",
  "private": false,
  "description": "Importe, organize e leia seus clippings do Kindle em Markdown",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @my-clippings/api dev & pnpm --filter @my-clippings/web dev",
    "dev:api": "pnpm --filter @my-clippings/api dev",
    "dev:web": "pnpm --filter @my-clippings/web dev",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "lint": "pnpm biome check . && pnpm eslint .",
    "lint:fix": "pnpm biome check --write . && pnpm eslint --fix .",
    "format": "pnpm biome format --write .",
    "format:check": "pnpm biome format .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "db:generate": "pnpm --filter @my-clippings/database db:generate",
    "db:migrate": "pnpm --filter @my-clippings/database db:migrate",
    "db:studio": "pnpm --filter @my-clippings/database db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "eslint": "^9.38.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  }
}
